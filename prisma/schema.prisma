generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  createdAt    DateTime    @default(now())
  capsules     Capsule[]
  sessions     Session[]
  contacts     Contact[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   @default("web")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model MpUser {
  id         String   @id @default(cuid())
  openid     String   @unique
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Capsule {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  subtitle     String?
  ownerName    String?
  rawContent   String
  manualContent String?
  knowledge    String
  learnedQA    String   @default("[]")
  transparency String   @default("persona")
  strictness   String   @default("high")
  shareToken   String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  threads     Thread[]
  escalations Escalation[]
  contacts    Contact[]
  files       CapsuleFile[]
  chunks      CapsuleChunk[]

  @@index([ownerId])
}

model CapsuleChunk {
  id        String   @id @default(cuid())
  capsuleId String
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  source    String
  content   String
  embedding String   @default("[]")
  index     Int
  createdAt DateTime @default(now())

  @@index([capsuleId])
}

model CapsuleFile {
  id        String   @id @default(cuid())
  capsuleId String
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  name      String
  content   String
  createdAt DateTime @default(now())

  @@index([capsuleId])
}

model Thread {
  id           String   @id @default(cuid())
  capsuleId    String
  capsule      Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  visitorId    String
  visitorLabel String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  messages    Message[]
  escalations Escalation[]

  @@unique([capsuleId, visitorId])
  @@index([capsuleId])
  @@index([contactId])
}

model Contact {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  capsuleId    String
  capsule      Capsule   @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  name         String
  note         String?
  token        String    @unique
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?
  threads      Thread[]

  @@index([ownerId])
  @@index([capsuleId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
}

model Escalation {
  id         String    @id @default(cuid())
  capsuleId  String
  capsule    Capsule   @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  question   String
  reason     String?
  status     String    @default("pending")
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([capsuleId, status])
  @@index([threadId])
}
