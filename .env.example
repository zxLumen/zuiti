# --- 数据库 ---
DATABASE_URL="file:./dev.db"

# --- 应用地址(用于生成分享链接) ---
# 留空时自动使用请求的 Host
# 线上:https://zuiti.zxlumen.cn
APP_URL=""

# --- AI 网关(OpenAI 兼容) ---
# 默认走 zxLumen AI 网关(和 agentbrain 同一个通道)
# 不填 LLM_API_KEY 时,系统进入「演示模式」,用本地规则模拟回答,方便先跑通流程
LLM_API_KEY="zxai_..."
LLM_BASE_URL="https://zxlumen.cn/api/ai/v1"
LLM_MODEL="deepseek-v4.1-flash"
# 主模型返回空 content / 429 / JSON 失败时,按顺序自动切换
LLM_FALLBACK_MODELS="glm-5.2,qwen3.8-flash,gpt-6-luna,claude-haiku-5-5"

# 向量检索(embeddings)
EMBEDDING_BASE_URL="https://zxlumen.cn/api/ai/v1"
EMBEDDING_API_KEY="zxai_..."
EMBEDDING_MODEL="bge-m3"

# 也可以直连 DeepSeek:
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL="deepseek-chat"

# --- 微信小程序 ---
# AppID 可以公开;AppSecret 只放服务端,绝对不要提交到 Git 或写进小程序代码
WX_MP_APPID="wx322b1ce49c5e982b"
WX_MP_SECRET=""
# 本地/体验版没有 AppSecret 时,允许用 devOpenid 调试
MP_DEV_MODE="true"

# --- 邮件(可选,用于发送登录验证码与「有新问题」提醒) ---
# 不配置时,开发环境会把验证码直接显示在登录页
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="嘴替 <no-reply@example.com>"

# 生产环境务必设为 false,避免验证码出现在页面上
AUTH_DEV_MODE="true"
