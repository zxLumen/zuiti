.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f4ee;
}

.chat-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  padding: 18rpx 28rpx 16rpx;
  background: rgba(250, 247, 241, 0.94);
  border-bottom: 1rpx solid rgba(214, 211, 209, 0.7);
}

.head-title {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1c1917;
  word-break: break-word;
}

.head-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fcd34d, #f97316, #f43f5e);
  color: #431407;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1c1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #78716c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.online {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 20rpx;
}

.online-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

.messages {
  flex: 1;
  height: 0;
}

.msg-list {
  padding: 28rpx 28rpx 16rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 26rpx;
}

.msg-row.left {
  align-items: flex-start;
}

.msg-row.right {
  align-items: flex-end;
}

.role {
  font-size: 19rpx;
  color: #a8a29e;
  margin-bottom: 8rpx;
  padding-left: 6rpx;
}

.bubble {
  max-width: 82%;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble.me {
  background: #1c1917;
  color: #faf7f1;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
}

.bubble.other {
  background: #ffffff;
  color: #292524;
  border: 1rpx solid rgba(214, 211, 209, 0.8);
  border-radius: 22rpx 22rpx 22rpx 6rpx;
}

.typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(214, 211, 209, 0.8);
  border-radius: 22rpx 22rpx 22rpx 6rpx;
}

.tdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a8a29e;
  animation: blink 1.2s infinite;
}

.tdot:nth-child(2) {
  animation-delay: 0.2s;
}

.tdot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-3rpx);
  }
}

.loading,
.empty {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  text-align: center;
}

.loading-mark,
.empty-mark {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fcd34d, #fb923c, #fb7185);
  color: #431407;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #78716c;
}

.empty-title {
  margin-top: 30rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #1c1917;
}

.empty-desc {
  margin-top: 16rpx;
  max-width: 560rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: #78716c;
}

.suggestions {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.suggestion {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(214, 211, 209, 0.9);
  background: rgba(255, 255, 255, 0.8);
  font-size: 23rpx;
  color: #57534e;
}

.empty-foot {
  margin-top: 56rpx;
  font-size: 20rpx;
  color: #a8a29e;
}

.retry {
  margin-top: 32rpx;
  padding: 18rpx 44rpx;
  border-radius: 18rpx;
  background: #1c1917;
  color: #faf7f1;
  font-size: 26rpx;
}

.composer {
  flex-shrink: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(250, 247, 241, 0.97);
  border-top: 1rpx solid rgba(214, 211, 209, 0.7);
}

.pending {
  margin-bottom: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  color: #92400e;
  font-size: 22rpx;
  line-height: 1.5;
}

.error {
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 22rpx;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 12rpx 14rpx;
  background: #ffffff;
  border: 1rpx solid rgba(214, 211, 209, 0.95);
  border-radius: 24rpx;
}

.input {
  flex: 1;
  min-height: 52rpx;
  max-height: 220rpx;
  padding: 8rpx 6rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1c1917;
  background: transparent;
}

.send {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #d6d3d1;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send.active {
  background: #1c1917;
}

.send[disabled] {
  opacity: 0.5;
}

.foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 19rpx;
  color: #a8a29e;
}

.home-link {
  color: #b45309;
}

.foot-dot {
  color: #d6d3d1;
}
