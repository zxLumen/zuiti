.page {
  min-height: 100vh;
  padding: 40rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
  background: #f7f4ee;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1c1917;
}

.updated {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a8a29e;
}

.section {
  margin-top: 36rpx;
}

.h {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}

.p {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #57534e;
}
