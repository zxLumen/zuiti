.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f4ee;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 4rpx 28rpx;
}

.brand {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #1c1917;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #a8a29e;
}

.logout {
  padding: 10rpx 18rpx;
  font-size: 23rpx;
  color: #78716c;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-link {
  font-size: 23rpx;
  color: #78716c;
}

.login-wrap {
  padding-top: 40rpx;
}

.login-card {
  padding: 40rpx 32rpx 32rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78716c;
}

.field-label {
  margin-top: 24rpx;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #78716c;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d6d3d1;
  background: #fafaf9;
  font-size: 28rpx;
  color: #1c1917;
}

.login-btn {
  margin-top: 26rpx;
}

.error {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 23rpx;
}

.privacy-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8a29e;
}

.login-hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.7;
  color: #a8a29e;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 4rpx 18rpx;
}

.pending-head {
  margin-top: 34rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1917;
}

.section-sub {
  font-size: 21rpx;
  color: #a8a29e;
}

.capsule-list,
.escalation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.capsule {
  padding: 28rpx;
}

.capsule-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.capsule-main {
  flex: 1;
  min-width: 0;
}

.capsule-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capsule-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #78716c;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pending-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 20rpx;
  font-weight: 600;
}

.capsule-meta {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #a8a29e;
}

.dot {
  margin: 0 10rpx;
}

.share-btn {
  margin-top: 24rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.contact-share {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #e7e5e4;
}

.contact-share-title {
  font-size: 21rpx;
  color: #a8a29e;
}

.contact-chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.contact-chip {
  margin: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 23rpx;
  border: 1rpx solid #fed7aa;
}

.file-manage {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e7e5e4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: #78716c;
}

.file-manage-arrow {
  color: #b45309;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #a8a29e;
}

.empty {
  padding: 44rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #a8a29e;
}

.escalation {
  padding: 26rpx;
}

.escalation-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chip {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
  color: #57534e;
  font-size: 20rpx;
}

.visitor {
  font-size: 20rpx;
  color: #a8a29e;
}

.escalation-q {
  margin-top: 16rpx;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #1c1917;
}

.escalation-go {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #b45309;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.7;
  color: #a8a29e;
}

.footer-link {
  color: #78716c;
}
