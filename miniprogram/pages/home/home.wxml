<view class="page">
  <view class="hero">
    <view class="mark">替</view>
    <view class="name">嘴替</view>
    <view class="tag">把想说的话,交给它。</view>
    <view class="desc">
      好友从分享卡片进入,直接提问;主人在这里管理自己的嘴替。
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="goOwner">
      {{hasOwner ? '进入我的嘴替' : '我是主人'}}
    </button>

    <button wx:if="{{hasLast}}" class="btn-ghost" bindtap="continueLast">
      继续上次的对话
    </button>
  </view>

  <view class="foot">
    好友无需登录 · 主人用邮箱 + 密码
  </view>
</view>
