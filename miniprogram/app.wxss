page {
  background: #f7f4ee;
  color: #1c1917;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
textarea,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
}

button::after {
  border: none;
}

.card {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(214, 211, 209, 0.8);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(28, 25, 23, 0.06);
}

.muted {
  color: #78716c;
}

.btn-primary {
  background: #1c1917;
  color: #faf7f1;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.4;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(214, 211, 209, 0.9);
  color: #44403c;
  border-radius: 18rpx;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  text-align: center;
}
